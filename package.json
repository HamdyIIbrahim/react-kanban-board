{
  "name": "react-custom-kanban-board",
  "version": "3.0.0",
  "type": "commonjs",
  "description": "A customizable, accessible React Kanban board: touch + keyboard drag-and-drop, controlled/uncontrolled state, headless hook, column management, card details, swimlanes, virtualization, i18n/RTL and SSR support.",
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/esm/utils.d.mts",
        "default": "./dist/esm/utils.js"
      },
      "require": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.js"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./KanbanBoard.css": "./dist/styles.css",
    "./dist/KanbanBoard.css": "./dist/KanbanBoard.css",
    "./dist/index": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./dist/index.js": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build:css && tsup && node scripts/postbuild.cjs",
    "build:css": "postcss src/KanbanBoard.css -o dist/styles.css --no-map",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "docs": "node scripts/generate-api-docs.cjs",
    "docs:check": "node scripts/generate-api-docs.cjs --check",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:package": "node scripts/smoke-package.mjs",
    "test:types": "tsc -p test/types/tsconfig.json",
    "test:readme": "node scripts/check-readme-examples.mjs",
    "lint:package": "publint --strict && attw --pack . --exclude-entrypoints styles.css KanbanBoard.css dist/KanbanBoard.css",
    "size": "size-limit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.14.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "^1.61.1",
    "@size-limit/preset-small-lib": "^13.1.1",
    "@types/react": "^16.* || ^17.* || ^18.* || ^19.*",
    "@types/react-dom": "^16.* || ^17.* || ^18.* || ^19.*",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.14",
    "framer-motion": "^11.18.2",
    "postcss": "^8.5.23",
    "postcss-cli": "^10.1.0",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^13.1.1",
    "tsup": "^9.0.0",
    "typescript": "^4.9.0 || ^5.0.0",
    "vite": "^8.1.6"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "files": [
    "dist/**/*",
    "utils/package.json",
    "docs/API.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "kanban-board",
    "react-kanban-board",
    "react-kanban",
    "kanban",
    "component",
    "react",
    "drag-and-drop",
    "task-management",
    "project-management",
    "trello",
    "board",
    "dnd-kit",
    "headless",
    "nextjs",
    "rtl"
  ],
  "author": "Hamdy Ibrahim",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HamdyIIbrahim/react-kanban-board.git"
  },
  "homepage": "https://github.com/HamdyIIbrahim/react-kanban-board#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "peerDependencies": {
    "react": ">=16.14.0",
    "react-dom": ">=16.14.0"
  },
  "bugs": {
    "url": "https://github.com/HamdyIIbrahim/react-kanban-board/issues"
  },
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.2"
    }
  },
  "size-limit": [
    {
      "name": "KanbanBoard (ESM, incl. dnd-kit, virtual + inlined CSS; min+brotli)",
      "path": "dist/esm/index.js",
      "import": "{ KanbanBoard }",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "44 kB"
    },
    {
      "name": "utils entry",
      "path": "dist/esm/utils.js",
      "limit": "3 kB"
    },
    {
      "name": "styles.css",
      "path": "dist/styles.css",
      "limit": "6 kB"
    }
  ]
}
